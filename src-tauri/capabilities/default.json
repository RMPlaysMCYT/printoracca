{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["Printoracca"],
  "permissions": [
    "core:default",
    "core:path:default",
    "core:event:default",
    "opener:default",
    "fs:default",
    "dialog:default",
    {
      "identifier": "fs:allow-exists",
      "allow": []
    },
    "fs:allow-read-file",
    "fs:allow-write-file",
    "dialog:allow-message",
    "opener:allow-open-path"
  ]
}